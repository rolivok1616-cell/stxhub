-- ==========================================
-- 2. ASCII KEY PROTECTION (THIS IS THE FIX!)
-- ==========================================
-- Spells "subtostx" using numbers.
local keyCodes = {115, 117, 98, 116, 111, 115, 116, 120}
local realKey = ""
for _, code in ipairs(keyCodes) do
    realKey = realKey .. string.char(code)
end

ContinueBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == realKey then
        AuthGui:Destroy()
        LoadMainHub()
    else
        KeyBox.Text = ""
        KeyBox.PlaceholderText = "Incorrect Key!"
        KeyBox.PlaceholderColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- ==========================================
-- 3. MAIN HUB FUNCTION (Rayfield)
-- ==========================================
function LoadMainHub()
    local success, Rayfield = pcall(function()
        return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    end)

    if not success then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "STX HUB",
            Text = "ERROR: Rayfield failed to load. Enable 'HTTP Requests' in your executor.",
            Duration = 10
        })
        return
    end

    local Window = Rayfield:CreateWindow({
        Name = "STX HUB | Premium",
        LoadingTitle = "STX HUB Loading...",
        LoadingSubtitle = "by STX",
        ConfigurationSaving = { Enabled = false },
        KeySystem = false
    })

    -- ESP TAB
    local ESPTab = Window:CreateTab("ESP", 4483362458)
    ESPTab:CreateSection("ESP Settings")
    ESPTab:CreateToggle({ Name = "Enable ESP", CurrentValue = false, Flag = "ESP_Enabled", Callback = function(state) Config.ESP.Enabled = state end })
    ESPTab:CreateToggle({ Name = "Show Box", CurrentValue = true, Flag = "ESP_Box", Callback = function(state) Config.ESP.Box = state end })
    ESPTab:CreateToggle({ Name = "Show Name", CurrentValue = true, Flag = "ESP_Name", Callback = function(state) Config.ESP.Name = state end })
    ESPTab:CreateToggle({ Name = "Show Distance", CurrentValue = true, Flag = "ESP_Distance", Callback = function(state) Config.ESP.Distance = state end })
    ESPTab:CreateToggle({ Name = "Show Health", CurrentValue = true, Flag = "ESP_Health", Callback = function(state) Config.ESP.Health = state end })
    ESPTab:CreateToggle({ Name = "Show Tracers", CurrentValue = true, Flag = "ESP_Tracers", Callback = function(state) Config.ESP.Tracers = state end })

    -- COMBAT TAB
    local CombatTab = Window:CreateTab("Combat", 4483362458)
    CombatTab:CreateSection("Aimbot Settings")
    CombatTab:CreateToggle({ Name = "Enable Aimbot", CurrentValue = false, Flag = "Combat_Aimbot", Callback = function(state) Config.Combat.Aimbot = state end })
    CombatTab:CreateToggle({ Name = "ALWAYS ACTIVE", CurrentValue = false, Flag = "Combat_AlwaysActive", Callback = function(state) Config.Combat.AlwaysActive = state end })
    CombatTab:CreateToggle({ Name = "Ignore Team", CurrentValue = true, Flag = "Combat_IgnoreTeam", Callback = function(state) Config.Combat.IgnoreTeam = state end })
    CombatTab:CreateToggle({ Name = "Wall Check", CurrentValue = true, Flag = "Combat_WallCheck", Callback = function(state) Config.Combat.WallCheck = state end })
    CombatTab:CreateToggle({ Name = "Prediction", CurrentValue = true, Flag = "Combat_Prediction", Callback = function(state) Config.Combat.Prediction = state end })
    CombatTab:CreateDropdown({ Name = "Aim Key", Options = {"MouseButton2", "MouseButton1", "E", "LeftAlt", "CapsLock", "LeftShift"}, CurrentOption = {"MouseButton2"}, Flag = "Combat_AimKey", Callback = function(option) Config.Combat.AimKey = option[1] end })
    CombatTab:CreateSlider({ Name = "FOV", Range = {10, 360}, Increment = 1, Suffix = " FOV", CurrentValue = 300, Flag = "Combat_FOV", Callback = function(val) Config.Combat.FOV = val end })
    CombatTab:CreateSlider({ Name = "Smoothness", Range = {1, 100}, Increment = 1, Suffix = "%", CurrentValue = 50, Flag = "Combat_Smoothness", Callback = function(val) Config.Combat.Smoothness = val / 100 end })
    CombatTab:CreateToggle({ Name = "Show FOV Circle", CurrentValue = true, Flag = "Combat_ShowFOV", Callback = function(state) Config.Combat.ShowFOV = state end })

    -- PLAYER LIST TAB
    local PlayerListTab = Window:CreateTab("Player List", 4483362458)
    PlayerListTab:CreateSection("Server Status")
    local PlayerListPara = PlayerListTab:CreateParagraph({ Title = "Loading...", Content = "Scanning game.Players..." })
    task.spawn(function()
        while task.wait(1) do
            local totalPlayers = #Players:GetPlayers() - 1
            local loadedPlayers = 0
            local charFolder = workspace:FindFirstChild("Characters")
            if charFolder then loadedPlayers = #charFolder:GetChildren() end
            pcall(function()
                PlayerListPara.Title = "Total Players in Server: " .. totalPlayers
                PlayerListPara.Content = "Players Loaded in Workspace: " .. loadedPlayers .. "\n\nIf 'Loaded' is lower than 'Total', the game uses StreamingEnabled. No script can ESP them until you get closer."
            end)
        end
    end)

    -- TARGET SCANNER
    local function GetTargets()
        local targets = {}
        local charFolder = workspace:FindFirstChild("Characters")
        if not charFolder then return targets end
        for _, child in ipairs(charFolder:GetChildren()) do
            if child:IsA("Model") or child:IsA("Folder") then
                local head = child:FindFirstChild("Head")
                local root = child:FindFirstChild("HumanoidRootPart")
                local charModel = child:FindFirstChild("CharacterModel")
                if charModel then
                    head = head or charModel:FindFirstChild("Head")
                    root = root or charModel:FindFirstChild("HumanoidRootPart")
                end
                if head and root then
                    local player = Players:GetPlayerFromCharacter(child) or Players:FindFirstChild(child.Name)
                    local hum = child:FindFirstChildOfClass("Humanoid") or (charModel and charModel:FindFirstChildOfClass("Humanoid"))
                    table.insert(targets, {Head = head, Root = root, Model = child, Player = player, Health = hum and hum.Health or 100})
                end
            end
        end
        return targets
    end

    -- DRAWING SETUP
    local ESPObjects = {}
    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 1
    FOVCircle.Color = Color3.fromRGB(0, 255, 0)
    FOVCircle.Filled = false
    FOVCircle.Transparency = 1
    FOVCircle.Visible = false

    local function CreateDrawing(target)
        local root = target.Root
        if ESPObjects[root] then return end
        local box = Drawing.new("Square")
        box.Thickness = 1
        box.Color = Color3.fromRGB(255, 0, 0)
        box.Filled = false
        box.Transparency = 1
        box.Visible = false
        local name = Drawing.new("Text")
        name.Size = 14
        name.Center = true
        name.Outline = true
        name.Color = Color3.fromRGB(255, 255, 255)
        name.Visible = false
        local health = Drawing.new("Text")
        health.Size = 12
        health.Center = true
        health.Outline = true
        health.Color = Color3.fromRGB(0, 255, 0)
        health.Visible = false
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1
        tracer.Color = Color3.fromRGB(255, 0, 0)
        tracer.Visible = false
        ESPObjects[root] = {Box = box, Name = name, Health = health, Tracer = tracer}
    end

    local cachedTargets = {}
    task.spawn(function()
        while task.wait(0.1) do
            cachedTargets = GetTargets()
        end
    end)

    -- MAIN RENDER LOOP
    RunService.RenderStepped:Connect(function()
        if Config.Combat.Aimbot and Config.Combat.ShowFOV then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Radius = Config.Combat.FOV
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end
        if Config.ESP.Enabled then
            for _, target in ipairs(cachedTargets) do CreateDrawing(target) end
            for root, esp in pairs(ESPObjects) do
                local targetData = nil
                for _, t in ipairs(cachedTargets) do
                    if t.Root == root then targetData = t break end
                end
                if targetData and root.Parent then
                    local vector, onScreen = Camera:WorldToViewportPoint(targetData.Head.Position)
                    if onScreen and vector.Z > 0 then
                        local top = Camera:WorldToViewportPoint(targetData.Head.Position + Vector3.new(0, 1, 0))
                        local bottom = Camera:WorldToViewportPoint(targetData.Root.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(top.Y - bottom.Y)
                        local width = height / 2
                        local distance = (Camera.CFrame.Position - targetData.Root.Position).Magnitude
                        esp.Box.Size = Vector2.new(width, height)
                        esp.Box.Position = Vector2.new(vector.X - width/2, top.Y)
                        esp.Box.Visible = Config.ESP.Box
                        local displayText = targetData.Model.Name
                        if Config.ESP.Distance then displayText = displayText .. " [" .. math.floor(distance) .. "m]" end
                        esp.Name.Position = Vector2.new(vector.X, top.Y - 18)
                        esp.Name.Text = displayText
                        esp.Name.Visible = Config.ESP.Name or Config.ESP.Distance
                        if Config.ESP.Health then
                            esp.Health.Position = Vector2.new(vector.X, top.Y + height + 2)
                            esp.Health.Text = "HP: " .. math.floor(targetData.Health)
                            esp.Health.Visible = true
                        else
                            esp.Health.Visible = false
                        end
                        if Config.ESP.Tracers then
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(vector.X, top.Y + height)
                            esp.Tracer.Visible = true
                        else
                            esp.Tracer.Visible = false
                        end
                    else
                        esp.Box.Visible = false
                        esp.Name.Visible = false
                        esp.Health.Visible = false
                        esp.Tracer.Visible = false
                    end
                else
                    esp.Box.Visible = false
                    esp.Name.Visible = false
                    esp.Health.Visible = false
                    esp.Tracer.Visible = false
                end
            end
        else
            for _, esp in pairs(ESPObjects) do
                esp.Box.Visible = false
                esp.Name.Visible = false
                esp.Health.Visible = false
                esp.Tracer.Visible = false
            end
        end
    end)

    -- COMBAT LOGIC
    local currentTarget = nil
    local function IsVisible(targetPart)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        local origin = Camera.CFrame.Position
        local direction = (targetPart.Position - origin)
        local result = workspace:Raycast(origin, direction, raycastParams)
        if result then return false end
        return true
    end

    task.spawn(function()
        while task.wait(0.05) do
            if Config.Combat.Aimbot then
                if Config.Combat.AlwaysActive then
                    Config.Combat.KeyPressed = true
                else
                    if Config.Combat.AimKey == "MouseButton2" or Config.Combat.AimKey == "MouseButton1" then
                        Config.Combat.KeyPressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType[Config.Combat.AimKey])
                    else
                        Config.Combat.KeyPressed = UserInputService:IsKeyDown(Enum.KeyCode[Config.Combat.AimKey])
                    end
                end
                if Config.Combat.KeyPressed then
                    local closest = nil
                    local shortestDist = Config.Combat.FOV
                    local center = Camera.ViewportSize / 2
                    for _, target in ipairs(cachedTargets) do
                        local isTeammate = false
                        if not Config.Combat.IgnoreTeam and target.Player and LocalPlayer.Team and target.Player.Team then
                            if target.Player.Team == LocalPlayer.Team then isTeammate = true end
                        end
                        if not isTeammate then
                            local partToAim = target.Head
                            if partToAim and partToAim.Parent then
                                local pos, onScreen = Camera:WorldToViewportPoint(partToAim.Position)
                                if onScreen and pos.Z > 0 then
                                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                    if dist < shortestDist then
                                        if not Config.Combat.WallCheck or IsVisible(partToAim) then
                                            shortestDist = dist
                                            closest = partToAim
                                        end
                                    end
                                end
                            end
                        end
                    end
                    currentTarget = closest
                else
                    currentTarget = nil
                end
            else
                currentTarget = nil
            end
        end
    end)

    RunService:BindToRenderStep("STX_Aimbot", Enum.RenderPriority.Camera.Value + 1, function()
        if Config.Combat.Aimbot and currentTarget and Config.Combat.KeyPressed then
            local targetPos = currentTarget.Position
            if Config.Combat.Prediction then
                local ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
                local velocity = currentTarget.AssemblyLinearVelocity or Vector3.new(0,0,0)
                targetPos = targetPos + (velocity * (ping * 1.5))
            end
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Combat.Smoothness)
        end
    end)

    Rayfield:Notify({
        Title = "STX HUB",
        Content = "Authentication successful! Welcome to STX HUB.",
        Duration = 5,
    })
end
