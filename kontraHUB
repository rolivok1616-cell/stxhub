            else
                if Config.Combat.AimKey == "MouseButton2" or Config.Combat.AimKey == "MouseButton1" then
                    Config.Combat.KeyPressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType[Config.Combat.AimKey])
                else
                    Config.Combat.KeyPressed = UserInputService:IsKeyDown(Enum.KeyCode[Config.Combat.AimKey])
                end
            end
            
            if Config.Combat.KeyPressed then
                local closest = nil
                local shortestDist = Config.Combat.FOV
                local bestHealth = 9999
                local center = Camera.ViewportSize / 2
                local targetLocked = false

                if Config.Combat.TargetLock and lockedTargetModel and lockedTargetModel.Parent then
                    local targetData = nil
                    for _, t in ipairs(cachedTargets) do
                        if t.Head == lockedTargetModel then targetData = t break end
                    end
                    
                    if targetData then
                        local pos, onScreen = Camera:WorldToViewportPoint(lockedTargetModel.Position)
                        if onScreen and pos.Z > 0 then
                            if not Config.Combat.WallCheck or IsVisible(lockedTargetModel) then
                                currentTarget = lockedTargetModel
                                targetLocked = true
                            end
                        end
                    end
                    if not targetLocked then
                        lockedTargetModel = nil
                    end
                end

                if not targetLocked then
                    for _, target in ipairs(cachedTargets) do
                        local partToAim = target.Head
                        if Config.Combat.TargetPart == "HumanoidRootPart" then partToAim = target.Root
                        elseif Config.Combat.TargetPart == "UpperTorso" and target.Torso then partToAim = target.Torso end
                        
                        if partToAim and partToAim.Parent then
                            local pos, onScreen = Camera:WorldToViewportPoint(partToAim.Position)
                            if onScreen and pos.Z > 0 then
                                local fovDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                local realDist = (Camera.CFrame.Position - partToAim.Position).Magnitude
                                
                                if fovDist < shortestDist then
                                    if not Config.Combat.WallCheck or IsVisible(partToAim) then
                                        if Config.Combat.TargetPriority == "FOV" then
                                            shortestDist = fovDist
                                            closest = partToAim
                                        elseif Config.Combat.TargetPriority == "Distance" then
                                            if realDist < shortestDist then
                                                shortestDist = realDist
                                                closest = partToAim
                                            end
                                        elseif Config.Combat.TargetPriority == "Health" then
                                            if target.Health < bestHealth then
                                                bestHealth = target.Health
                                                closest = partToAim
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    if closest then
                        currentTarget = closest
                        lockedTargetModel = closest
                    else
                        currentTarget = nil
                        lockedTargetModel = nil
                    end
                end
            else
                currentTarget = nil
                lockedTargetModel = nil
            end
        else
            currentTarget = nil
            lockedTargetModel = nil
        end
    end
end)

RunService:BindToRenderStep("STX_Aimbot", Enum.RenderPriority.Last.Value, function()
    if Config.Combat.Aimbot and currentTarget and Config.Combat.KeyPressed then
        if Config.Combat.AimbotMode == "Camera" or Config.Combat.AimbotMode == "Mouse" then
            if Config.Combat.ForceCamera then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                if Camera.CameraType ~= Enum.CameraType.Scriptable then
                    originalCameraType = Camera.CameraType
                    Camera.CameraType = Enum.CameraType.Scriptable
                end
            end

            local targetPos = currentTarget.Position
            
            if Config.Combat.Prediction then
                local ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
                local velocity = currentTarget.AssemblyLinearVelocity or currentTarget.Velocity or Vector3.new(0,0,0)
                targetPos = targetPos + (velocity * (ping * Config.Combat.PredictionMultiplier))
            end
            
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
            
            if Config.Combat.InstantSnap then
                Camera.CFrame = targetCFrame
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Combat.Smoothness)
            end

            if Config.Combat.CharacterLock then
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local lookVector = (Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z) - hrp.Position).Unit
                        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + lookVector)
                    end
                end
            end
        end
        
        if Config.Combat.AutoShoot and lockedTargetModel then
            if tick() - lastShotTime > 0.15 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(lockedTargetModel.Position)
                local center = Camera.ViewportSize / 2
                local distToCrosshair = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                
                if onScreen and distToCrosshair < 20 then
                    pcall(function()
                        mouse1click()
                    end)
                    lastShotTime = tick()
                end
            end
        end
    else
        if Config.Combat.ForceCamera and Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = originalCameraType
        end
    end
end)

