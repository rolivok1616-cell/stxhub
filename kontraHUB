-- ==========================================
RunService.RenderStepped:Connect(function()
    if Config.Combat.Aimbot and Config.Combat.ShowFOV then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = Config.Combat.FOV
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- Player ESP & Hitbox
    if Config.Visuals.Enabled or Config.Hitbox.Enabled then
        for _, target in ipairs(cachedTargets) do 
            CreateDrawing(target) 
            if Config.Visuals.Chams then ApplyChams(target.Model, true) end
            if Config.Hitbox.Enabled then ApplyHitbox(target, true) end
        end
        
        for root, esp in pairs(ESPObjects) do
            local targetData = nil
            for _, t in ipairs(cachedTargets) do
                if t.Root == root then targetData = t break end
            end
            
            local isValidTarget = false
            if targetData and targetData.Health > 0 and root.Parent then
                isValidTarget = true
            end

            if isValidTarget then
                local vector, onScreen = Camera:WorldToViewportPoint(targetData.Head.Position)
                if onScreen and vector.Z > 0 then
                    local top = Camera:WorldToViewportPoint(targetData.Head.Position + Vector3.new(0, 1, 0))
                    local bottom = Camera:WorldToViewportPoint(targetData.Root.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(top.Y - bottom.Y)
                    local width = height / 2
                    local distance = (Camera.CFrame.Position - targetData.Root.Position).Magnitude
                    
                    esp.Box.Size = Vector2.new(width, height)
                    esp.Box.Position = Vector2.new(vector.X - width/2, top.Y)
                    esp.Box.Visible = Config.Visuals.Box
                    
                    local displayText = targetData.Model.Name
                    if Config.Visuals.Distance then displayText = displayText .. " [" .. math.floor(distance) .. "m]" end
                    
                    esp.Name.Position = Vector2.new(vector.X, top.Y - 18)
                    esp.Name.Text = displayText
                    esp.Name.Visible = Config.Visuals.Name or Config.Visuals.Distance
                    
                    if Config.Visuals.Health then
                        esp.Health.Position = Vector2.new(vector.X, top.Y + height + 2)
                        esp.Health.Text = "HP: " .. math.floor(targetData.Health)
                        esp.Health.Visible = true
                    else
                        esp.Health.Visible = false
                    end
                    
                    if Config.Visuals.Tracers then
                        esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        esp.Tracer.To = Vector2.new(vector.X, top.Y + height)
                        esp.Tracer.Visible = true
                    else
                        esp.Tracer.Visible = false
                    end
                else
                    esp.Box.Visible = false
                    esp.Name.Visible = false
                    esp.Health.Visible = false
                    esp.Tracer.Visible = false
                end
            else
                esp.Box.Visible = false
                esp.Name.Visible = false
                esp.Health.Visible = false
                esp.Tracer.Visible = false
                
                if not targetData or targetData.Health <= 0 or not root.Parent then
                    esp.Box:Remove()
                    esp.Name:Remove()
                    esp.Health:Remove()
                    esp.Tracer:Remove()
                    ESPObjects[root] = nil
                    if targetData and targetData.Model then ApplyChams(targetData.Model, false) end
                    if targetData then ApplyHitbox(targetData, false) end
                end
            end
        end
    else
        for _, esp in pairs(ESPObjects) do
            esp.Box.Visible = false
            esp.Name.Visible = false
            esp.Health.Visible = false
            esp.Tracer.Visible = false
        end
        for part, originalColor in pairs(OriginalColors) do
            if part and part.Parent then part.Color = originalColor end
            OriginalColors[part] = nil
        end
        for part, originalData in pairs(OriginalSizes) do
            if part and part.Parent then
                part.Size = originalData.Size
                part.Transparency = originalData.Transparency
                part.CanCollide = originalData.CanCollide
            end
            OriginalSizes[part] = nil
        end
    end

    -- Bomb ESP Logic
    if Config.Visuals.BombEnabled then
        local bomb = workspace:FindFirstChild("Debris") and workspace.Debris:FindFirstChild("Bomb")
        if bomb then
            local bombPos = bomb:IsA("BasePart") and bomb.Position or (bomb:IsA("Model") and bomb:GetModelCFrame().Position)
            if bombPos then
                local vector, onScreen = Camera:WorldToViewportPoint(bombPos)
                if onScreen and vector.Z > 0 then
                    local distance = (Camera.CFrame.Position - bombPos).Magnitude
                    BombBox.Size = Vector2.new(20, 20)
                    BombBox.Position = Vector2.new(vector.X - 10, vector.Y - 10)
                    BombBox.Visible = true
                    
                    BombName.Position = Vector2.new(vector.X, vector.Y - 25)
                    BombName.Text = "BOMB"
                    if Config.Visuals.BombDistance then BombName.Text = BombName.Text .. " [" .. math.floor(distance) .. "m]" end
                    BombName.Visible = Config.Visuals.BombName or Config.Visuals.BombDistance
                    
                    if Config.Visuals.BombTracers then
                        BombTracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        BombTracer.To = Vector2.new(vector.X, vector.Y)
                        BombTracer.Visible = true
                    else
                        BombTracer.Visible = false
                    end
                else
                    BombBox.Visible = false
                    BombName.Visible = false
                    BombTracer.Visible = false
                end
            else
                BombBox.Visible = false
                BombName.Visible = false
                BombTracer.Visible = false
            end
        else
            BombBox.Visible = false
            BombName.Visible = false
            BombTracer.Visible = false
        end
    else
        BombBox.Visible = false
        BombName.Visible = false
        BombTracer.Visible = false
    end
end)

